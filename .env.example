# Copy to .env for LOCAL development only, or set these env vars on Render.
# NEVER commit a real .env to git. NEVER add real secrets here.

# Listen address (Render expects 0.0.0.0 + the injected PORT)
HOST=0.0.0.0
PORT=3000

NODE_ENV=development
# Set SEED_DEMO=true locally to create demo student/lecturer/tickets on a fresh DB.
# Production must keep SEED_DEMO=false (demo data is never auto-seeded in production).
SEED_DEMO=true

# --- Persistent storage (production / Render) ---
# On Render: DATA_DIR=/var/data (persistent disk). DATABASE_PATH is kept for
# explicit overrides and recovery. Order: DATABASE_PATH > DATA_DIR > ./data
DATA_DIR=/var/data
DATABASE_PATH=/var/data/helpdesk.sqlite
# Optional explicit upload dirs (default: $DATA_DIR/uploads and $DATA_DIR/sounds,
# or assets/uploads + assets/sounds locally):
# UPLOADS_DIR=/var/data/uploads
# SOUNDS_DIR=/var/data/sounds

# --- Initial administrator (used ONLY when NO admin exists yet) ---
# Generate a strong random password (min 10 chars) and set it in the dashboard.
# The account is flagged must_change_password — change it at /admin immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Set to "true" when serving over HTTPS (Render always uses HTTPS).
# Adds the Secure flag to session cookies (HttpOnly + SameSite=Lax always).
COOKIE_SECURE=true
